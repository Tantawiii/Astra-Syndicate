    title: 'Chapter 1: Frontier Watch'
    synopsis: Placeholder story. Your fleet is posted to the Kepler relay just as
      Syndicate raiders start probing the frontier.
    order: 1
    missions:
    - id: ch01_m01
      title: First Contact
      briefing: Raider scouts are circling the relay. Intercept and destroy them
        before they report back.
      sceneName: Ch01_M01
      timeLimitSeconds: 0
      objectives:
      - id: destroy_scouts
