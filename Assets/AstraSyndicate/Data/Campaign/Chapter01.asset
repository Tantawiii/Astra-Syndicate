        description: Destroy the raider scouts
        targetCount: 5
        durationSeconds: 0
        targetId: 
        optional: 0
    - id: ch01_m02
      title: Hold the Line
      briefing: A raider strike group is inbound. Keep the relay alive until reinforcements
        jump in.
      sceneName: Ch01_M02
      timeLimitSeconds: 0
      objectives:
      - id: defend_relay
        type: survive
        description: Defend the relay
        targetCount: 0
        durationSeconds: 60
        targetId: 
        optional: 0
      - id: thin_the_herd
        type: destroy_enemies
        description: Destroy 10 raiders
        targetCount: 10
        durationSeconds: 0
        targetId: 
        optional: 1
    - id: ch01_m03
      title: Into the Rift
      briefing: The raiders fell back through the rift. Reach the rift gate before
